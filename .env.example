# Comma-separated frontend origins allowed to call the Cookie Lab API.
# Replace the example domain when deploying. Never commit the real .env file.
COOKIE_LAB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://your-cookie-lab-site.example

# Comma-separated hostnames accepted by the API. Do not include URL schemes.
COOKIE_LAB_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,your-cookie-api.example

# Set to production on the deployed backend to disable interactive API documentation.
COOKIE_LAB_ENV=development
